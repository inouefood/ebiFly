    "NSUserTrackingUsageDescription" : {
      "comment" : "Privacy - Tracking Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تُستخدم بياناتك لعرض إعلانات تناسبك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Така можем да ти показваме реклами, които са интересни за теб."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার উপযোগী বিজ্ঞাপন দেখাতে এই তথ্য ব্যবহার করা হয়।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "S’utilitza per mostrar-te anuncis que t’interessin."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Díky tomu ti můžeme ukazovat reklamy, které tě zajímají."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bruges til at vise dig reklamer, der passer til dig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wird verwendet, um dir Werbung zu zeigen, die zu dir passt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Χρησιμοποιείται για να σου δείχνουμε διαφημίσεις που σου ταιριάζουν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Your data is used to show you ads that are more relevant to you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se usa para mostrarte anuncios que te interesen."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se usa para mostrarte anuncios que te interesen."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seda teavet kasutatakse teile sobivate reklaamide näitamiseks."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tietojasi käytetään, jotta voimme näyttää sinulle sopivampia mainoksia."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ginagamit ang impormasyong ito para magpakita ng mga ad na angkop sa iyo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Utilisé pour t’afficher des publicités adaptées à tes goûts."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમને અનુરૂપ જાહેરાતો બતાવવા માટે આ માહિતી વપરાય છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "המידע משמש להצגת פרסומות שמתאימות לך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इसका इस्तेमाल तुम्हें तुम्हारी पसंद के विज्ञापन दिखाने के लिए किया जाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tako ti možemo prikazivati oglase koji te zanimaju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Arra használjuk, hogy hozzád illő hirdetéseket mutassunk."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informasi ini digunakan untuk menampilkan iklan yang relevan bagi Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Serve a mostrarti pubblicità più adatte a te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "あなたに合った広告を表示するために使用します。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бұл ақпарат сізге сәйкес жарнамаларды көрсету үшін пайдаланылады."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಿಮಗೆ ಹೊಂದುವ ಜಾಹೀರಾತುಗಳನ್ನು ತೋರಿಸಲು ಈ ಮಾಹಿತಿಯನ್ನು ಬಳಸಲಾಗುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "사용자에게 맞는 광고를 표시하는 데 사용됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ši informacija naudojama, kad jums būtų rodomos tinkamos reklamos."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šī informācija tiek izmantota, lai rādītu jums atbilstošas reklāmas."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങൾക്കു യോജിച്ച പരസ്യങ്ങൾ കാണിക്കാൻ ഈ വിവരങ്ങൾ ഉപയോഗിക്കും."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुमच्यासाठी उपयुक्त जाहिराती दाखवण्यासाठी ही माहिती वापरली जाते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maklumat ini digunakan untuk memaparkan iklan yang relevan kepada anda."
