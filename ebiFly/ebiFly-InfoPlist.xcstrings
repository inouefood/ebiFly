    "NSUserTrackingUsageDescription" : {
      "comment" : "Privacy - Tracking Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تُستخدم بياناتك لعرض إعلانات تناسبك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Така можем да ти показваме реклами, които са интересни за теб."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "S’utilitza per mostrar-te anuncis que t’interessin."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Díky tomu ti můžeme ukazovat reklamy, které tě zajímají."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bruges til at vise dig reklamer, der passer til dig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wird verwendet, um dir Werbung zu zeigen, die zu dir passt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Χρησιμοποιείται για να σου δείχνουμε διαφημίσεις που σου ταιριάζουν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Your data is used to show you ads that are more relevant to you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se usa para mostrarte anuncios que te interesen."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se usa para mostrarte anuncios que te interesen."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tietojasi käytetään, jotta voimme näyttää sinulle sopivampia mainoksia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Utilisé pour t’afficher des publicités adaptées à tes goûts."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "המידע משמש להצגת פרסומות שמתאימות לך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इसका इस्तेमाल तुम्हें तुम्हारी पसंद के विज्ञापन दिखाने के लिए किया जाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tako ti možemo prikazivati oglase koji te zanimaju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Arra használjuk, hogy hozzád illő hirdetéseket mutassunk."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Serve a mostrarti pubblicità più adatte a te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "あなたに合った広告を表示するために使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "사용자에게 맞는 광고를 표시하는 데 사용됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Brukes til å vise deg reklame som passer for deg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wordt gebruikt om je advertenties te tonen die bij je passen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dzięki temu możemy pokazywać reklamy dopasowane do Ciebie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Usamos isso para mostrar anúncios que combinam com você."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Serve para te mostrar anúncios mais adequados a ti."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Folosim datele ca să-ți arătăm reclame potrivite pentru tine."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Это нужно, чтобы показывать рекламу, которая подходит именно тебе."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Používa sa na zobrazovanie reklám, ktoré ťa môžu zaujímať."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tako ti lahko prikazujemo oglase, ki te zanimajo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Används för att visa reklam som passar dig."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Verilerin sana daha uygun reklamlar göstermek için kullanılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Це потрібно, щоб показувати рекламу, яка цікава саме тобі."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "用于向你展示更适合你的广告。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "用於顯示適合你的廣告。"
          }
        }
      }
    }
  },
  "version" : "1.3"
