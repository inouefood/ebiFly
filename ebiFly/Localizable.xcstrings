            "value" : "Chytej láhve (%@) – to je palivo. Jedna srážka a je konec!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Saml %@-flasker som brændstof. Ét bump, og det er slut!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sammle Flaschen mit %@ als Sprit. Ein Crash, und es ist vorbei!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Πιάσε μπουκάλια «%@» για καύσιμο. Ένα χτύπημα και τέλος!"
