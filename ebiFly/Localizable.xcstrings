    "ふった回数で飛ぶ高さと上昇スピードがアップ" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "كلما هززت أكثر، طرت أعلى وأسرع"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Колкото повече разклащаш, толкова по-високо и по-бързо летиш"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Com més sacsegis, més amunt i més de pressa volarà"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Čím víc třeseš, tím výš a rychleji letíš"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jo mere du ryster, jo højere og hurtigere flyver du"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Je öfter du schüttelst, desto höher und schneller fliegst du"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Όσο πιο πολύ κουνάς, τόσο πιο ψηλά και πιο γρήγορα πετάς"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "The more you shake, the higher and faster you fly"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cuanto más agites, más alto y rápido subirá."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mientras más agites, más alto y más rápido sube."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mitä enemmän ravistat, sitä korkeammalle ja nopeammin lennät"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Plus tu secoues, plus tu montes haut et vite."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ככל שמנערים יותר, טסים גבוה ומהר יותר"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "जितना ज़्यादा हिलाओगे, उतना ऊँचा और तेज़ उड़ोगे"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Što više treseš, to letiš više i brže"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Minél többet rázod, annál magasabbra és gyorsabban repülsz"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Più scuoti, più voli in alto e veloce"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "많이 흔들수록 더 높이, 더 빨리 올라가요"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jo mer du rister, jo høyere og raskere flyr du"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hoe vaker je schudt, hoe hoger en sneller je vliegt"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Im więcej potrząśnięć, tym wyżej i szybciej lecisz"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Quanto mais você chacoalhar, mais alto e mais rápido o camarão voa"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Quanto mais abanares, mais alto e mais depressa voas"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cu cât scuturi mai mult, cu atât zbori mai sus și mai repede"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Чем больше трясёшь, тем выше и быстрее полёт"
          }
        },
