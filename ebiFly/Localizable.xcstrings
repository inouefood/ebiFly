    "長いほどパン粉がつきやすく距離ものびる。でも空では当たり判定が大きくなる。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "كلما كان أطول، التصق به فتات خبز أكثر وطار أبعد. لكن في السماء يصبح الاصطدام أسهل."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Колкото е по-дълга, толкова повече галета полепва и толкова по-далеч лети. Но в небето по-лесно се удря."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "লম্বা চিংড়িতে পাঙ্কো সহজে লাগে, আরও দূরে ওড়ে, তবে ধাক্কাও বেশি লাগে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Com més llarga, més pa ratllat s’hi enganxa i més lluny arriba. Però al cel xoca més fàcilment."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Čím je delší, tím víc strouhanky se nalepí a tím dál doletí. Ale ve vzduchu do něčeho snáz narazí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jo længere rejen er, jo mere rasp sætter sig fast, og jo længere flyver den. Men i luften rammer den lettere noget."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Je länger, desto mehr Brösel und desto weiter. Aber am Himmel stößt du leichter an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Όσο πιο μακριά είναι, τόσο περισσότερη γαλέτα κολλάει και τόσο πιο πολύ πετάει. Στον ουρανό όμως χτυπάει πιο εύκολα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "The longer it is, the more panko sticks and the farther it flies. But in the sky, it’s easier to hit things."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cuanto más larga, más pan rallado atrapa y más lejos llega. Pero en el cielo choca más fácilmente."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mientras más largo, más pan molido atrapa y más lejos llega. Pero en el cielo choca más fácil."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pikema kreveti külge jääb panko kergemini ja ta lendab kaugemale. Aga ta põrkab ka kergemini millegi vastu."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mitä pidempi rapu, sitä enemmän korppujauhoa tarttuu ja sitä pidemmälle lennät. Taivaalla osut kuitenkin helpommin esteisiin."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mas madaling kapitan ng panko at mas malayo ang lipad ng mahabang hipon, pero mas madali rin itong bumangga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Plus elle est longue, plus le panko colle et plus elle vole loin. Mais dans le ciel, elle se cogne plus facilement."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "લાંબા ઝીંગાને પાન્કો સહેલાઈથી ચોંટે છે અને તે દૂર ઊડે છે, પણ ટક્કર થવાની શક્યતા વધારે છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ככל שהשרימפ ארוך יותר, נדבקים אליו יותר פירורי לחם והוא טס רחוק יותר. אבל בשמיים קל יותר להתנגש."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "जितना लंबा, उतना ज़्यादा ब्रेड चूरा चिपकेगा और उतना दूर उड़ेगा। पर आसमान में टकराना भी आसान होगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Što je dulji, prezle se bolje lijepe i leti dalje. Ali u zraku lakše u nešto udari."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Minél hosszabb, annál több morzsa ragad rá, és annál messzebb repül. De az égen könnyebben nekimegy valaminek."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udang panjang lebih mudah dilapisi panko dan terbang lebih jauh, tapi lebih mudah menabrak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Più è lungo, più pangrattato prende e più lontano vola. Ma in cielo è più facile sbattere."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ұзын асшаянға панко жақсы жабысады әрі ол алысқа ұшады. Бірақ кедергіге оңай тиеді."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಉದ್ದದ ಸೀಗಡಿಗೆ ಪಾಂಕೊ ಸುಲಭವಾಗಿ ಅಂಟುತ್ತದೆ, ದೂರ ಹಾರುತ್ತದೆ. ಆದರೆ ಡಿಕ್ಕಿಯಾಗುವ ಸಾಧ್ಯತೆಯೂ ಹೆಚ್ಚು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "길수록 빵가루가 잘 묻고 더 멀리 날아요. 하지만 하늘에서는 더 잘 부딪혀요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilgesnė krevetė lengviau aplimpa panko ir skrenda toliau, bet dažniau atsitrenkia."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garākai garnelei panko pielīp vieglāk, un tā lido tālāk, taču biežāk saduras ar šķēršļiem."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നീളമുള്ള ചെമ്മീനിൽ പാങ്കോ എളുപ്പം പിടിക്കും, കൂടുതൽ ദൂരം പറക്കും. പക്ഷേ തടസ്സങ്ങളിൽ ഇടിക്കാനും എളുപ്പമാണ്."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लांब कोळंबीला पांको पटकन लागतो आणि ती दूर उडते. पण तिची धडकही लवकर होते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udang panjang lebih mudah disalut panko dan terbang lebih jauh, tapi lebih mudah terlanggar."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jo lengre den er, jo mer panko fester seg og jo lenger flyr den. Men i lufta er det lettere å treffe ting."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hoe langer, hoe meer panko eraan plakt en hoe verder je vliegt. Maar in de lucht bots je ook sneller ergens tegen."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਲੰਮੇ ਝੀਂਗੇ ਨੂੰ ਪਾਂਕੋ ਸੌਖਾ ਚਿਪਕਦਾ ਹੈ ਤੇ ਉਹ ਦੂਰ ਉੱਡਦਾ ਹੈ, ਪਰ ਟੱਕਰ ਵੀ ਸੌਖੀ ਲੱਗਦੀ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Im dłuższa, tym więcej panko się przykleja i tym dalej leci. Ale w niebie łatwiej o zderzenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Quanto mais longo, mais panko gruda e mais longe ele voa. Mas, no céu, fica mais fácil bater."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Quanto mais comprido, mais pão ralado apanha e mais longe voa. Mas, no céu, é mais fácil bater nas coisas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cu cât e mai lung, cu atât prinde mai mult pesmet și zboară mai departe. Dar pe cer e mai ușor de lovit."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Чем длиннее, тем больше сухарей налипает и тем дальше полёт. Но в небе легче во что-нибудь врезаться."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Čím je dlhšia, tým viac strúhanky sa prilepí a tým ďalej doletí. Ale na oblohe ľahšie do niečoho narazí."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Daljši ko je, več drobtin se prime in dlje leti. A v zraku ga ovire lažje zadenejo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ju längre räka, desto mer panko fastnar och desto längre flyger den. Men i luften krockar den lättare."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இறால் நீளமானால் பாங்கோ எளிதில் ஒட்டும், அதிக தூரம் பறக்கும். ஆனால் மோதுவதும் எளிது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "పొడవు రొయ్యకు పాంకో సులభంగా అంటుతుంది, దూరంగా ఎగురుతుంది. కానీ ఢీకొనే అవకాశం ఎక్కువ."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตัวยิ่งยาวยิ่งติดเกล็ดง่ายและบินไกล แต่ก็ชนง่ายขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ne kadar uzunsa o kadar çok galeta unu yapışır ve o kadar uzağa uçar. Ama gökyüzünde bir şeylere çarpması da kolaylaşır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Що довша креветка, то більше панко налипає і то далі вона летить. Але в небі в неї легше влучити."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لمبے جھینگے پر پانکو آسانی سے لگتا ہے اور وہ دور تک اڑتا ہے، مگر ٹکر بھی جلد لگتی ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tôm càng dài càng dễ bám bột xù và bay xa, nhưng cũng dễ va chạm hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "越长越容易粘上面包糠，也飞得更远。但在空中也更容易撞到东西。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "越長越容易沾到麵包粉，也飛得更遠。但在空中也更容易撞到東西。"
          }
        }
      }
    },
