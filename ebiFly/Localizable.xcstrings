        "ms" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Ketik atau seret ke mana-mana arah. Yang emas dikira 3. Jika terkena titisan air, %lld biji jatuh."
                }
              }
            }
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Trykk eller dra for å flytte rundt. Gylne teller som 3. Treffer du en vanndråpe, mister du %lld."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tik of sleep om te bewegen. Gouden tellen voor 3. Raak je een waterdruppel, dan verlies je er %lld."
          }
        },
        "pa" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "ਕਿਸੇ ਵੀ ਪਾਸੇ ਜਾਣ ਲਈ ਟੈਪ ਕਰ ਜਾਂ ਖਿੱਚ। ਸੁਨਹਿਰੀ ਟੁਕੜਾ 3 ਦੇ ਬਰਾਬਰ ਹੈ। ਬੂੰਦ ਵੱਜੇ ਤਾਂ %lld ਟੁਕੜਾ ਡਿੱਗੇਗਾ।"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "ਕਿਸੇ ਵੀ ਪਾਸੇ ਜਾਣ ਲਈ ਟੈਪ ਕਰ ਜਾਂ ਖਿੱਚ। ਸੁਨਹਿਰੀ ਟੁਕੜਾ 3 ਦੇ ਬਰਾਬਰ ਹੈ। ਬੂੰਦ ਵੱਜੇ ਤਾਂ %lld ਟੁਕੜੇ ਡਿੱਗਣਗੇ।"
                }
              }
            }
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stuknij lub przeciągnij, żeby się ruszać. Złote liczą się za 3. Kropla wody zabiera %lld."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
