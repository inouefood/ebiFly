        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Saat 1 pt jokaisesta lentämästäsi 10 metristä. Vaihtamasi tavarat voit ottaa käyttöön ”Valmista”-näkymässä."
          }
        },
        "fr" : {
          "stringUnit" : {
