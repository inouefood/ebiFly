        },
        "mr" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "सर्व दिशांना जायला टॅप कर किंवा ओढ. सोनेरी तुकडा 3 तुकड्यांएवढा आहे. पाण्याचा थेंब लागला तर %lld तुकडा पडेल."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "सर्व दिशांना जायला टॅप कर किंवा ओढ. सोनेरी तुकडा 3 तुकड्यांएवढा आहे. पाण्याचा थेंब लागला तर %lld तुकडे पडतील."
