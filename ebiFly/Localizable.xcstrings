    "タップかドラッグで上下左右に動かせる。金色のは3こぶん。水てきに当たると%lldこ落ちる" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اضغط أو اسحب للتحرك في كل الاتجاهات. القطعة الذهبية تُحسب بـ٣. إذا أصابتك قطرة ماء تخسر %lld"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Докосвай или плъзгай, за да се движиш. Златните са за 3. Удари ли те капка вода, губиш %lld."
          }
        },
        "bn" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "যেকোনো দিকে যেতে টোকা দাও বা টানো। সোনালিটা 3টির সমান। জলের ফোঁটায় লাগলে %lldটি পড়ে যাবে।"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "যেকোনো দিকে যেতে টোকা দাও বা টানো। সোনালিটা 3টির সমান। জলের ফোঁটায় লাগলে %lldটি পড়ে যাবে।"
                }
              }
            }
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Toca o arrossega per moure’t. Les daurades valen per 3. Si et toca una gota d’aigua, en perds %lld."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ťukni nebo táhni a hýbej se všemi směry. Zlaté se počítají za 3. Kapka vody ti vezme %lld."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tryk eller træk for at flytte rundt. Gyldne tæller som 3. Rammer du en vanddråbe, mister du %lld."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tipp oder zieh, um dich zu bewegen. Goldene zählen dreifach. Ein Wassertropfen kostet dich %lld."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Άγγιξε ή σύρε για να κινηθείς. Τα χρυσά μετράνε για 3. Αν σε βρει σταγόνα νερού, χάνεις %lld."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tap or drag to move around. Gold ones count as 3. Hit a water drop and you lose %lld."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Toca o arrastra para moverte. Las doradas valen por 3. Si te da una gota de agua, pierdes %lld."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Toca o arrastra para moverte. Las piezas doradas valen por 3. Si te cae una gota de agua, pierdes %lld."
          }
        },
        "et" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Puuduta või lohista igas suunas. Kuldne tükk loeb kolmena. Veetilka puudutades kukub %lld tk maha."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Puuduta või lohista igas suunas. Kuldne tükk loeb kolmena. Veetilka puudutades kukub %lld tk maha."
                }
              }
            }
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Liiku napauttamalla tai vetämällä. Kultaiset lasketaan kolmena. Jos osut vesipisaraan, menetät %lld."
          }
        },
        "fil" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Pindutin o i-drag sa kahit anong direksiyon. Katumbas ng 3 ang ginto. Kapag natamaan ng patak, mahuhulog ang %lld piraso."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Pindutin o i-drag sa kahit anong direksiyon. Katumbas ng 3 ang ginto. Kapag natamaan ng patak, mahuhulog ang %lld piraso."
                }
              }
            }
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Touche ou fais glisser pour bouger. Les morceaux dorés comptent triple. Une goutte d’eau t’en fait perdre %lld."
          }
        },
        "gu" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "બધી દિશામાં ખસવા ટૅપ કર કે ખેંચ. સોનેરી ટુકડો 3 જેટલો ગણાય. પાણીનું ટીપું વાગે તો %lld ટુકડો પડે."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "બધી દિશામાં ખસવા ટૅપ કર કે ખેંચ. સોનેરી ટુકડો 3 જેટલો ગણાય. પાણીનું ટીપું વાગે તો %lld ટુકડા પડે."
                }
              }
            }
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מקישים או גוררים כדי לזוז לכל כיוון. הזהובים שווים 3. טיפת מים מורידה %lld."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "टैप करो या खींचो, चारों ओर घूमो। सुनहरा दाना 3 के बराबर। पानी की बूँद लगी तो %lld कम"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dodirni ili povuci za kretanje. Zlatne vrijede 3. Ako te pogodi kap vode, gubiš %lld."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Koppints vagy húzz, hogy mozogj. Az arany 3-at ér. Vízcseppnél %lld db lepotyog."
          }
        },
        "id" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Ketuk atau seret ke segala arah. Yang emas dihitung 3. Terkena tetes air, %lld buah jatuh."
                }
              }
            }
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tocca o trascina per muoverti. Quelli d’oro valgono 3. Se ti colpisce una goccia d’acqua, ne perdi %lld."
          }
        },
        "kk" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Кез келген бағытқа жылжу үшін түрт не сүйре. Алтын түстісі 3 данаға тең. Су тамшысына тисең, %lld дана түседі."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Кез келген бағытқа жылжу үшін түрт не сүйре. Алтын түстісі 3 данаға тең. Су тамшысына тисең, %lld дана түседі."
                }
