        "ml" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "എല്ലാ ദിശയിലേക്കും നീങ്ങാൻ തൊടുകയോ വലിക്കുകയോ ചെയ്യൂ. സ്വർണ കഷണം 3 എണ്ണത്തിന് തുല്യം. വെള്ളത്തുള്ളി തട്ടിയാൽ %lld കഷണം വീഴും."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "എല്ലാ ദിശയിലേക്കും നീങ്ങാൻ തൊടുകയോ വലിക്കുകയോ ചെയ്യൂ. സ്വർണ കഷണം 3 എണ്ണത്തിന് തുല്യം. വെള്ളത്തുള്ളി തട്ടിയാൽ %lld കഷണങ്ങൾ വീഴും."
