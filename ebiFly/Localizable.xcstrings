    "とんだきょり10mごとに1pt。こうかんしたアイテムは「つくる」画面でつけかえられます。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تحصل على ١ pt لكل ١٠ m من الطيران. يمكنك تغيير العناصر التي استبدلتها في شاشة «اصنع»."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "1 pt за всеки 10 m полет. Сменяй разменените предмети на екрана „Направи“."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Guanyes 1 pt per cada 10 m de vol. Pots canviar els objectes bescanviats a la pantalla «Crea»."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Za každých 10 m letu dostaneš 1 pt. Vyměněné věci si nasadíš na obrazovce „Vyrob“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Du får 1 pt for hver 10 m, du flyver. Ting, du har byttet til dig, kan du skifte til under “Lav”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Alle 10 m Flugweite gibt es 1 pt. Eingetauschte Sachen kannst du unter „Bauen“ wechseln."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "machine_translated",
