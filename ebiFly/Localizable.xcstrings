    "燃料をつかいきるまで とんだ！" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "طرت حتى نفد الوقود!"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Летя до последната капка гориво!"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Has volat fins a esgotar el combustible!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Krevetka letěla, dokud nedošlo palivo!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Du fløj, til brændstoffet slap op!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Geflogen bis zum letzten Tropfen Sprit!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Πέταξες μέχρι να τελειώσει το καύσιμο!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "You flew until the fuel ran out!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "¡Has volado hasta agotar el combustible!"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "¡Volaste hasta agotar el combustible!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lensit, kunnes polttoaine loppui!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tu as volé jusqu’à la dernière goutte !"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "טסת עד טיפת הדלק האחרונה!"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ईंधन ख़त्म होने तक उड़ते रहे!"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Let do zadnje kapi goriva!"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Repültél, amíg el nem fogyott az üzemanyag!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hai volato fino all’ultima goccia!"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "연료를 다 쓸 때까지 날았어요!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Du fløy til drivstoffet var brukt opp!"
          }
        },
