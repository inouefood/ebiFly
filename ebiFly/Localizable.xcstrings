    "ショップでポイントとこうかんできます（「つくる」画面や結果画面から）。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "استبدل النقاط بعناصر في المتجر (من شاشة «اصنع» أو شاشة النتائج)."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Разменяй точки за предмети в магазина (от екрана „Направи“ или от екрана с резултата)."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Els pots aconseguir amb punts a la botiga (des de la pantalla «Crea» o la de resultats)."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Body vyměníš za věci v obchodě (z obrazovky „Vyrob“ nebo z výsledků)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Byt point til ting i butikken (fra “Lav” eller resultatskærmen)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tausche Punkte im Shop gegen Sachen ein (über „Bauen“ oder das Ergebnis)."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Άλλαξε πόντους με αντικείμενα στο μαγαζί (από την οθόνη «Φτιάξε» ή την οθόνη αποτελεσμάτων)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Trade points for items in the Shop (from the Make screen or the results screen)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Canjéalos por puntos en la tienda (desde la pantalla “Crear” o la de resultados)."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Canjea tus puntos por objetos en la tienda (desde la pantalla “Crear” o la de resultados)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vaihda pisteitä tavaroihin Kaupassa (”Valmista”-näkymästä tai tulosnäkymästä)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Échange tes points contre des objets dans la boutique (depuis l’écran « Créer » ou l’écran des résultats)."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "בחנות אפשר להחליף נקודות בפריטים (ממסך ״הכנה״ או ממסך התוצאות)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "शॉप में पॉइंट देकर आइटम ले सकते हो (“बनाओ” स्क्रीन या नतीजे की स्क्रीन से)।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zamijeni bodove za predmete u trgovini (sa zaslona „Napravi“ ili s rezultata)."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A boltban pontokért kaphatsz tárgyakat (a „Készítés” vagy az eredmény képernyőről)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Scambia i punti con gli oggetti nel negozio (dalla schermata Crea o dai risultati)."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "상점에서 포인트로 교환할 수 있어요(‘만들기’ 화면이나 결과 화면에서)."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bytt poeng mot ting i butikken (fra «Lag»-skjermen eller resultatskjermen)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ruil punten voor items in de winkel (via het scherm “Maken” of het resultatenscherm)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wymieniaj punkty na rzeczy w sklepie (z ekranu „Zrób” lub ekranu wyników)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Troque pontos por itens na Loja (pela tela “Criar” ou pela tela de resultados)."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Troca pontos por itens na loja (no ecrã “Criar” ou no ecrã de resultados)."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Schimbă punctele pe obiecte în magazin (din ecranul „Creează” sau din ecranul de rezultate)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Обменивай очки на вещи в магазине (с экрана «Лепить» или экрана итогов)."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Body vymeníš za veci v obchode (z obrazovky „Vyrobiť“ alebo z výsledkov)."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Točke zamenjaš za stvari v trgovini (z zaslona „Naredi“ ali z rezultatov)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Byt poäng mot saker i butiken (via ”Skapa” eller resultatskärmen)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Puanlarını mağazada eşyalarla takas edebilirsin (“Yap” ekranından veya sonuç ekranından)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Обмінюй бали на речі в крамниці (з екрана «Зробити» або екрана результатів)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "可以在商店用积分兑换（从“制作”界面或结果界面进入）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "可以在商店用點數兌換（從「製作」畫面或結果畫面前往）。"
          }
        }
      }
    },
