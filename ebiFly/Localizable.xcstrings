        "kn" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "ಎಲ್ಲ ದಿಕ್ಕುಗಳಿಗೂ ಸರಿಸಲು ಟ್ಯಾಪ್ ಮಾಡು ಅಥವಾ ಎಳೆ. ಚಿನ್ನದ ತುಂಡು 3ಕ್ಕೆ ಸಮ. ನೀರಿನ ಹನಿ ತಾಗಿದರೆ %lld ತುಂಡು ಬೀಳುತ್ತದೆ."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "ಎಲ್ಲ ದಿಕ್ಕುಗಳಿಗೂ ಸರಿಸಲು ಟ್ಯಾಪ್ ಮಾಡು ಅಥವಾ ಎಳೆ. ಚಿನ್ನದ ತುಂಡು 3ಕ್ಕೆ ಸಮ. ನೀರಿನ ಹನಿ ತಾಗಿದರೆ %lld ತುಂಡುಗಳು ಬೀಳುತ್ತವೆ."
