    "タップかドラッグで上下左右に動かせる。金色のは3こぶん。水てきに当たると%lldこ落ちる" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اضغط أو اسحب للتحرك في كل الاتجاهات. القطعة الذهبية تُحسب بـ٣. إذا أصابتك قطرة ماء تخسر %lld"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Докосвай или плъзгай, за да се движиш. Златните са за 3. Удари ли те капка вода, губиш %lld."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Toca o arrossega per moure’t. Les daurades valen per 3. Si et toca una gota d’aigua, en perds %lld."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ťukni nebo táhni a hýbej se všemi směry. Zlaté se počítají za 3. Kapka vody ti vezme %lld."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tryk eller træk for at flytte rundt. Gyldne tæller som 3. Rammer du en vanddråbe, mister du %lld."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tipp oder zieh, um dich zu bewegen. Goldene zählen dreifach. Ein Wassertropfen kostet dich %lld."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Άγγιξε ή σύρε για να κινηθείς. Τα χρυσά μετράνε για 3. Αν σε βρει σταγόνα νερού, χάνεις %lld."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tap or drag to move around. Gold ones count as 3. Hit a water drop and you lose %lld."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Toca o arrastra para moverte. Las doradas valen por 3. Si te da una gota de agua, pierdes %lld."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Toca o arrastra para moverte. Las piezas doradas valen por 3. Si te cae una gota de agua, pierdes %lld."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Liiku napauttamalla tai vetämällä. Kultaiset lasketaan kolmena. Jos osut vesipisaraan, menetät %lld."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Touche ou fais glisser pour bouger. Les morceaux dorés comptent triple. Une goutte d’eau t’en fait perdre %lld."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "מקישים או גוררים כדי לזוז לכל כיוון. הזהובים שווים 3. טיפת מים מורידה %lld."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "टैप करो या खींचो, चारों ओर घूमो। सुनहरा दाना 3 के बराबर। पानी की बूँद लगी तो %lld कम"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dodirni ili povuci za kretanje. Zlatne vrijede 3. Ako te pogodi kap vode, gubiš %lld."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Koppints vagy húzz, hogy mozogj. Az arany 3-at ér. Vízcseppnél %lld db lepotyog."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tocca o trascina per muoverti. Quelli d’oro valgono 3. Se ti colpisce una goccia d’acqua, ne perdi %lld."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "탭하거나 드래그해서 상하좌우로 움직여요. 금색은 3개로 쳐요. 물방울에 맞으면 %lld개 떨어져요"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Trykk eller dra for å flytte rundt. Gylne teller som 3. Treffer du en vanndråpe, mister du %lld."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tik of sleep om te bewegen. Gouden tellen voor 3. Raak je een waterdruppel, dan verlies je er %lld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Stuknij lub przeciągnij, żeby się ruszać. Złote liczą się za 3. Kropla wody zabiera %lld."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Toque ou arraste para mover. Os dourados valem 3. Se bater numa gota d’água, você perde %lld."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Toca ou arrasta para te mexeres. Os dourados valem 3. Se te cair uma gota de água, perdes %lld."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Atinge sau trage ca să te miști. Bucățile aurii valorează cât 3. Dacă te lovește o picătură de apă, pierzi %lld."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Тапай или тяни, чтобы двигаться. Золотая крошка — за три. Попадёт капля воды — минус %lld."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ťukni alebo potiahni a hýb sa všade. Zlaté sa rátajú trikrát. Keď ťa trafí kvapka vody, prídeš o %lld."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tapni ali povleci in se premikaj na vse strani. Zlate štejejo za 3. Kapljica vode ti vzame %lld."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tryck eller dra för att flytta. Guldiga räknas som 3. Träffar du en vattendroppe tappar du %lld."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hareket etmek için dokun veya sürükle. Altın olanlar 3 sayılır. Su damlasına çarparsan %lld tane düşer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Торкайся або тягни, щоб рухатися. Золоті рахуються за 3. Крапля води забирає %lld."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "轻点或拖动就能上下左右移动。金色的算3个。碰到水滴会掉%lld个"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "點一下或拖移就能上下左右移動。金色的算3個。碰到水滴會掉%lld個"
          }
        }
      }
    },
