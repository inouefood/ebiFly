        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ganas 1 pt por cada 10 m de vuelo. Puedes ponerle los objetos canjeados en la pantalla “Crear”."
          }
        },
        "es-419" : {
          "stringUnit" : {
